{
  "expo": {
    "name": "FITZY",
    "slug": "fitzy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitzy",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF5EE",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "FITZY uses the camera so you can add clothes to your closet.",
        "NSPhotoLibraryUsageDescription": "FITZY needs photo access so you can upload your wardrobe.",
        "NSLocationWhenInUseUsageDescription": "FITZY uses your location to fetch local weather for outfit picks."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF5EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF5EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FITZY needs photo access so you can upload your wardrobe.",
          "cameraPermission": "FITZY uses the camera so you can add clothes to your closet."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FITZY uses your location to fetch local weather for outfit picks."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
