# FITZY environment variables
# Copy to .env and fill in. NEVER commit real values.
#
# Only PUBLIC values belong here — EXPO_PUBLIC_* vars are bundled into the
# client. The Supabase anon key is safe to ship (RLS protects all data).
#
# SECRET keys (OpenAI, Supabase service-role) must NEVER appear in this file
# or anywhere in the app code. They live in Supabase Edge Function secrets:
#   supabase secrets set OPENAI_API_KEY=sk-...

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
